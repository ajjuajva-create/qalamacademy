<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#172b4d">
<title>Qalam Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#f8f7f3;--paper2:#f1efe8;--white:#fff;
  --ink:#17202a;--navy:#172b4d;--navy2:#243b5a;
  --green:#3f6b5b;--green2:#315647;--greenbg:#e7f0eb;
  --gold:#c8903a;--goldbg:#f7eddc;
  --blue:#3d7190;--bluebg:#e7f0f5;
  --purple:#765a8c;--purplebg:#eee8f2;
  --red:#a94b4b;--redbg:#f7e7e7;
  --muted:#64748b;--border:#ddd9cf;
  --shadow:0 18px 50px rgba(23,43,77,.10);
  --radius:22px;--font:'Plus Jakarta Sans',sans-serif;
  --serif:'DM Serif Display',Georgia,serif;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{min-height:100%;font-family:var(--font);color:var(--ink);background:#ecefe6;font-size:16px}
body{display:flex;justify-content:center;align-items:flex-start}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}

.app{
  width:100%;min-height:100vh;background:var(--paper);
  position:relative;overflow:hidden;display:flex;flex-direction:column;
}
@media(min-width:900px){
  body{padding:24px 0}
  .app{
    max-width:1200px;min-height:92vh;border-radius:28px;
    border:1px solid rgba(255,255,255,.8);box-shadow:0 30px 80px rgba(15,23,42,.15);
  }
}
.screen{min-height:100%;overflow-y:auto;scroll-behavior:smooth}
.container{width:min(100%,1040px);margin:auto;padding:0 28px 120px}
.serif{font-family:var(--serif)}
h1{font-size:clamp(30px,4.5vw,48px);line-height:1.15;color:var(--navy)}
h2{font-size:24px;color:var(--navy);line-height:1.25}
h3{font-size:18px;color:var(--navy);line-height:1.3}
p{line-height:1.65;font-size:15px}
.muted{color:var(--muted)}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:800}

.btn{
  border:0;border-radius:14px;padding:14px 22px;font-weight:800;
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  transition:.15s;font-size:14px;cursor:pointer
}
.btn:active{transform:translateY(2px)}
.btn-primary{background:var(--navy);color:#fff;box-shadow:0 4px 0 #0e1d34}
.btn-green{background:var(--green);color:#fff;box-shadow:0 4px 0 var(--green2)}
.btn-outline{background:#fff;color:var(--navy);border:1.5px solid var(--border)}
.btn-soft{background:var(--paper2);color:var(--navy)}
.btn:disabled{opacity:.45;cursor:not-allowed;box-shadow:none;transform:none}

.topbar{
  height:74px;background:rgba(255,255,255,.96);border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;padding:0 28px;
  position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)
}
.brand{display:flex;align-items:center;gap:12px;font-weight:800;color:var(--navy);text-decoration:none}
.brand-mark{width:42px;height:42px;border-radius:12px;background:var(--navy);display:grid;place-items:center}
.brand-mark svg{width:24px;height:24px}
.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:.16em;text-transform:uppercase;font-weight:800}
.nav-links{display:flex;gap:8px}
.nav-btn{border:0;background:transparent;color:var(--muted);padding:10px 15px;border-radius:12px;font-size:14px;font-weight:800;transition:.15s}
.nav-btn:hover,.nav-btn.active{background:var(--paper2);color:var(--navy)}

.auth{
  min-height:100%;display:grid;place-items:center;padding:32px 20px;
  background:radial-gradient(circle at 15% 15%,rgba(200,144,58,.13),transparent 30%),
             radial-gradient(circle at 90% 80%,rgba(63,107,91,.13),transparent 30%),var(--paper);
}
.auth-card{width:min(100%,480px);background:#fff;border:1px solid var(--border);border-radius:30px;padding:38px 34px;box-shadow:var(--shadow)}
.auth-head{text-align:center;margin-bottom:28px}
.auth-emblem{width:68px;height:68px;border-radius:20px;background:var(--navy);display:grid;place-items:center;margin:0 auto 14px}
.auth-emblem svg{width:38px;height:38px}
.auth-head h1{font-size:28px;color:var(--navy)}
.auth-head p{font-size:14px;color:var(--muted);margin-top:8px}
.tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--paper2);padding:4px;border-radius:14px;margin-bottom:20px}
.tab{border:0;background:transparent;padding:12px;border-radius:10px;font-size:13px;font-weight:800;color:var(--muted);transition:.15s}
.tab.active{background:#fff;color:var(--navy);box-shadow:0 2px 6px rgba(0,0,0,.06)}
.field{margin-bottom:16px}
.field label{display:block;font-size:12px;font-weight:800;color:var(--navy);margin-bottom:8px}
.field input,.field textarea,.field select{width:100%;border:1.5px solid var(--border);background:#fff;border-radius:14px;padding:14px;outline:none;color:var(--ink);font-size:15px;transition:.2s}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--navy);box-shadow:0 0 0 3px rgba(23,43,77,.08)}

.habit{
  background:var(--navy);color:#fff;border-radius:24px;padding:22px 26px;
  display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:center;
  box-shadow:var(--shadow);margin:24px 0
}
.streak{min-width:88px;padding:12px 14px;border:1px solid rgba(255,255,255,.18);border-radius:16px;text-align:center;background:rgba(255,255,255,.07)}
.streak strong{font-size:32px;color:#e9c477;display:block}
.streak span{font-size:10px;letter-spacing:.12em;font-weight:800;opacity:.75}
.tier{font-size:11px;font-weight:800;padding:6px 12px;border-radius:10px;background:rgba(255,255,255,.12);display:inline-block;margin-bottom:6px}
.habit-title{font-size:18px;font-weight:800}
.habit-text{font-size:13px;opacity:.78;margin-top:4px}
.xp{text-align:right}.xp strong{display:block;font-size:22px}.xp span{font-size:10px;opacity:.65}

.today{background:#fff;border:1.5px solid var(--border);border-radius:24px;padding:24px;display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:center;box-shadow:0 8px 24px rgba(23,43,77,.05)}
.skill-icon{width:64px;height:64px;border-radius:18px;background:var(--greenbg);display:grid;place-items:center;color:var(--green);font-size:26px;flex:none}
.meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.meta span{font-size:11px;font-weight:800;padding:6px 10px;border-radius:8px;background:var(--paper2);color:var(--muted)}

.lesson-list{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.lesson-card{background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:20px;display:flex;gap:16px;align-items:flex-start;min-height:140px;cursor:pointer;transition:.2s;position:relative}
.lesson-card.locked{opacity:.55;cursor:not-allowed}
.lesson-card.done{border-color:#bfd3c8;background:var(--greenbg)}
.done-badge{position:absolute;top:14px;right:14px;width:24px;height:24px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-size:12px;font-weight:800}
.lesson-icon{width:48px;height:48px;border-radius:14px;background:var(--bluebg);display:grid;place-items:center;font-size:22px;flex:none}

.winding-path{padding:16px 20px 36px;display:flex;flex-direction:column;align-items:center;position:relative}
.winding-path::before{content:'';position:absolute;top:0;bottom:0;left:50%;width:4px;background:repeating-linear-gradient(to bottom,var(--border) 0px,var(--border) 8px,transparent 8px,transparent 16px);transform:translateX(-50%);z-index:0}
.path-node-wrap{position:relative;z-index:1;margin-bottom:34px;display:flex;flex-direction:column;align-items:center}
.path-node-wrap:nth-child(odd){align-self:flex-start;margin-left:14%}
.path-node-wrap:nth-child(even){align-self:flex-end;margin-right:14%}
.path-node-wrap:nth-child(3n){align-self:center;margin-left:0;margin-right:0}
.path-node{width:86px;height:86px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;cursor:pointer;transition:transform .15s;border:4px solid #fff}
.path-node.node-active{background:var(--green);box-shadow:0 8px 0 var(--green2)}
.path-node.node-done{background:var(--gold);box-shadow:0 8px 0 #8c6020}
.path-node.node-locked{background:#e8e5df;box-shadow:0 8px 0 #ccc;cursor:not-allowed;color:#aaa}
.path-node-label{margin-top:10px;background:#fff;border:1.5px solid var(--border);border-radius:12px;padding:6px 14px;font-size:12px;font-weight:800;text-align:center}

.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.skill-card{background:#fff;border:1.5px solid var(--border);border-radius:18px;padding:16px}
.progress-bar{height:9px;background:var(--paper2);border-radius:99px;overflow:hidden;margin-top:10px}
.progress-bar i{display:block;height:100%;background:var(--green);border-radius:99px}

.lab-tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--paper2);padding:4px;border-radius:14px;margin-bottom:20px;gap:6px}
.lab-tab{border:0;background:transparent;padding:12px 10px;border-radius:10px;font-size:13px;font-weight:800;color:var(--muted);transition:.15s}
.lab-tab.active{background:#fff;color:var(--navy);box-shadow:0 2px 6px rgba(0,0,0,.06)}
.lab-box{background:#fff;border:1.5px solid var(--border);border-radius:24px;padding:24px}
textarea.large{min-height:220px;resize:vertical;line-height:1.7;font-size:15px}
.lab-actions{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap}
.feedback-results{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px}
.score-box{background:var(--paper);border-radius:14px;padding:14px;text-align:center}
.score-box strong{font-size:22px;color:var(--navy);display:block}
.score-box span{font-size:10px;font-weight:800;color:var(--muted)}
.feedback-points{margin-top:14px;display:flex;flex-direction:column;gap:8px}
.feedback-points div{font-size:13px;background:var(--greenbg);color:var(--green2);padding:12px 14px;border-radius:12px;line-height:1.5}

.lab-task-list{display:flex;flex-direction:column;gap:14px}
.lab-task{background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:20px;cursor:pointer;transition:.2s}
.lab-task:hover{border-color:var(--green);box-shadow:0 6px 16px rgba(63,107,91,.1)}
.lab-task.done{border-color:#bfd3c8;background:var(--greenbg)}
.lab-task.active-task{border-color:var(--navy);box-shadow:0 0 0 3px rgba(23,43,77,.08)}
.lab-task-header{display:flex;align-items:center;gap:14px;margin-bottom:8px}
.lab-task-num{width:36px;height:36px;border-radius:10px;background:var(--paper2);display:grid;place-items:center;font-size:14px;font-weight:800;color:var(--navy);flex:none}
.lab-task.done .lab-task-num{background:var(--green);color:#fff}
.lab-task-title{font-size:16px;font-weight:800;color:var(--navy)}
.lab-task-meta{font-size:12px;color:var(--muted);margin-top:2px}
.lab-task-body{display:none;margin-top:16px}
.lab-task.active-task .lab-task-body{display:block}
.lab-task-prompt{background:var(--goldbg);border-left:3px solid var(--gold);border-radius:0 12px 12px 0;padding:14px 16px;font-size:14px;color:#725629;margin-bottom:14px;line-height:1.65}
.lab-task textarea{width:100%;min-height:130px;padding:14px;border:1.5px solid var(--border);border-radius:14px;font-size:15px;line-height:1.7;resize:none;outline:none;background:var(--paper)}
.lab-task textarea:focus{border-color:var(--navy);background:#fff}

.report-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.metric{background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:18px}
.metric strong{display:block;font-size:28px;color:var(--navy)}
.metric span{font-size:11px;font-weight:800;color:var(--muted);letter-spacing:.08em}
.week-card{background:#fff;border:1.5px solid var(--border);border-radius:24px;padding:22px;margin-top:16px}
.days{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin-top:16px}
.day{text-align:center}
.day span{display:block;font-size:11px;color:var(--muted);font-weight:800;margin-bottom:8px}
.day i{display:block;height:48px;border-radius:14px;background:var(--paper2);border:1px solid var(--border)}
.day.done i{background:var(--greenbg);border-color:#bfd3c8}
.day.today i{outline:2px solid var(--gold)}

.lesson-screen{background:var(--paper);min-height:100vh}
.lessonbar{height:70px;background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:16px;padding:0 24px;position:sticky;top:0;z-index:20}
.lessonbar .bar{flex:1;height:10px;background:var(--paper2);border-radius:99px;overflow:hidden}
.lessonbar .bar i{display:block;height:100%;background:var(--green);transition:.4s}
.lesson-main{width:min(100%,820px);margin:auto;padding:32px 24px 140px}
.teach{background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:20px;margin:18px 0}
.teach .weak-ex{background:var(--redbg);padding:13px 15px;border-radius:12px;font-size:14px;margin:10px 0}
.teach .strong-ex{background:var(--greenbg);padding:13px 15px;border-radius:12px;font-size:14px}
.option{width:100%;text-align:left;border:1.5px solid var(--border);background:#fff;border-radius:16px;padding:16px 18px;margin-bottom:12px;font-size:15px;cursor:pointer}
.option.selected{border-color:var(--navy);background:var(--bluebg)}
.option.correct{border-color:var(--green);background:var(--greenbg)}
.option.wrong{border-color:var(--red);background:var(--redbg)}

.lesson-footer{
  position:fixed;bottom:0;left:0;right:0;
  background:rgba(255,255,255,.98);border-top:1.5px solid var(--border);
  padding:16px 24px calc(16px + env(safe-area-inset-bottom));
  z-index:90;box-shadow:0 -10px 30px rgba(0,0,0,0.06);
}
.lesson-footer-inner{width:min(100%,820px);margin:auto;display:flex;justify-content:space-between;gap:16px;align-items:center}
.lesson-feedback{flex:1;font-size:14px;font-weight:700}

.result-wrap{min-height:100vh;display:grid;place-items:center;padding:28px}
.result-card{width:min(100%,540px);text-align:center;background:#fff;border:1.5px solid var(--border);border-radius:30px;padding:36px;box-shadow:var(--shadow)}

.mobile-nav{display:none}
@media(max-width:768px){
  .topbar{height:66px;padding:0 18px}
  .nav-links{display:none}
  .mobile-nav{
    display:flex;position:fixed;bottom:0;left:0;right:0;background:rgba(255,255,255,.98);
    border-top:1px solid var(--border);z-index:40;
    padding:8px 8px calc(8px + env(safe-area-inset-bottom));
    justify-content:space-around;
  }
  body.in-lesson .mobile-nav{display:none!important}
  .mobile-nav button{border:0;background:transparent;color:var(--muted);font-size:11px;font-weight:800;display:flex;flex-direction:column;align-items:center}
  .mobile-nav button.active{color:var(--navy)}
  .container{padding:0 18px 120px}
  .lesson-list,.skills,.report-grid,.feedback-results{grid-template-columns:1fr}
  .lesson-footer-inner{flex-direction:column;gap:10px}
  .lesson-footer .btn{width:100%}
}
.toast{position:fixed;right:18px;bottom:84px;background:var(--navy);color:#fff;padding:14px 18px;border-radius:14px;font-size:13px;font-weight:700;z-index:200}
</style>
</head>
<body>
<div class="app">

<!-- AUTH -->
<div id="authScreen" class="screen hidden">
  <div class="auth">
    <div class="auth-card">
      <div class="auth-head">
        <div class="auth-emblem">
          <svg viewBox="0 0 36 36" fill="none">
            <path d="M18 4L30 14L18 32L6 14Z" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.4)"/>
            <path d="M12 16L18 10L24 16L18 28Z" fill="rgba(255,255,255,0.18)" stroke="rgba(255,255,255,0.5)"/>
            <path d="M18 10L18 28" stroke="#e9c477" stroke-width="1.5"/>
            <circle cx="18" cy="28" r="2" fill="#e9c477"/>
          </svg>
        </div>
        <h1 class="serif">Qalam Academy</h1>
        <p>Simple, clean writing training for everyday writers.</p>
      </div>
      <div class="tabs">
        <button class="tab active" id="tabLogin" onclick="setAuthMode('login')">Sign in</button>
        <button class="tab" id="tabSignup" onclick="setAuthMode('signup')">Create account</button>
      </div>
      <div class="field"><label>Username</label><input type="text" id="authEmail" placeholder="e.g. ajvad"></div>
      <div class="field"><label>Passphrase</label><input type="password" id="authPassword" placeholder="••••••••"></div>
      <button class="btn btn-primary" style="width:100%;margin-top:6px" id="authButton" onclick="handleAuth()">SIGN IN →</button>
    </div>
  </div>
</div>

<!-- APP -->
<section id="appScreen" class="screen hidden">
  <div class="topbar">
    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 36 36" fill="none">
          <path d="M18 4L30 14L18 32L6 14Z" fill="rgba(255,255,255,0.1)"/>
          <path d="M18 11L18 27" stroke="#e9c477" stroke-width="1.5"/>
          <circle cx="18" cy="27" r="2" fill="#e9c477"/>
        </svg>
      </div>
      <div><span style="font-size:17px;font-weight:800">Qalam</span><small>Academy</small></div>
    </div>
    <div class="nav-links">
      <button class="nav-btn active" id="navHome" onclick="navigate('home')">Home</button>
      <button class="nav-btn" id="navLearn" onclick="navigate('learn')">Learn</button>
      <button class="nav-btn" id="navLab" onclick="navigate('lab')">Writing Lab</button>
      <button class="nav-btn" id="navProgress" onclick="navigate('progress')">Progress</button>
    </div>
    <button class="btn btn-outline" style="padding:6px 12px;font-size:12px" onclick="logout()">Exit</button>
  </div>

  <!-- HOME -->
  <div id="homePage" class="page">
    <div class="container">
      <div class="habit">
        <div class="streak"><strong id="streakNum">1</strong><span>STREAK</span></div>
        <div>
          <div class="tier" id="tierPill">Writer</div>
          <div class="habit-title" id="greeting">Welcome back.</div>
          <div class="habit-text">Pick up a lesson or jump into unlimited practice below.</div>
        </div>
        <div class="xp"><strong id="xpNum">0 XP</strong><span>TOTAL</span></div>
      </div>

      <div style="margin-bottom:20px">
        <button class="btn btn-green" style="width:100%;padding:16px;font-size:16px" onclick="startEndlessPractice()">⚡ Unlimited Practice Drill (+15 XP)</button>
      </div>

      <div class="section">
        <div class="section-head"><div><div class="eyebrow">Today</div><h2>Focal Practice</h2></div></div>
        <div id="todayCard" class="today"></div>
      </div>

      <div class="section">
        <div class="section-head"><div><div class="eyebrow">Curriculum</div><h2>Step-by-Step Training</h2></div></div>
        <div id="lessonList" class="lesson-list"></div>
      </div>
    </div>
  </div>

  <!-- LEARN -->
  <div id="learnPage" class="page hidden">
    <div class="container">
      <div style="padding:32px 0 20px">
        <div class="eyebrow">Training Roadmap</div>
        <h1 class="serif">The Path to Clear Writing.</h1>
      </div>
      <div class="winding-path" id="windingPath"></div>
    </div>
  </div>

  <!-- WRITING LAB -->
  <div id="labPage" class="page hidden">
    <div class="container">
      <div style="padding:32px 0 16px">
        <div class="eyebrow">Studio</div>
        <h1 class="serif">Writing Lab & Arena.</h1>
      </div>
      <div class="lab-tabs">
        <button class="lab-tab active" id="labTabTasks" onclick="switchLabTab('tasks')">📝 Guided Tasks</button>
        <button class="lab-tab" id="labTabAnalyse" onclick="switchLabTab('analyse')">✦ Paragraph Analyser</button>
      </div>

      <div id="labTasks">
        <div class="lab-task-list" id="labTaskList"></div>
      </div>

      <div id="labAnalyse" class="hidden">
        <div class="lab-box">
          <div class="field">
            <label>Writing Style</label>
            <select id="labType">
              <option>General Paragraph</option>
              <option>Essay Introduction</option>
              <option>Personal Reflection</option>
            </select>
          </div>
          <div class="field">
            <label>Your Draft</label>
            <textarea id="labText" class="large" placeholder="Paste or type your draft here to check sentence length, filler words, and readability..."></textarea>
          </div>
          <div class="lab-actions">
            <span class="muted" style="font-size:12px">Instant readability check.</span>
            <button class="btn btn-green" onclick="evaluateWriting()">Analyze Writing →</button>
          </div>
          <div id="labResults" class="hidden">
            <div class="feedback-results" id="scoreGrid"></div>
            <div class="feedback-points" id="feedbackPoints"></div>
            <div style="margin-top:16px;display:flex;gap:10px">
              <button class="btn btn-soft" onclick="clearLab()">Reset Draft</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PROGRESS -->
  <div id="progressPage" class="page hidden">
    <div class="container">
