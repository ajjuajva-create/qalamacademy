async function handleAuth() {
  const u = document.getElementById('authEmail').value.trim().toLowerCase();
  const p = document.getElementById('authPassword').value.trim();
  const btn = document.getElementById('authButton');
  if(!u || !p){ toast('Enter username and password'); return; }

  btn.disabled = true;
  btn.textContent = 'CONNECTING TO SUPABASE…';

  try {
    if (authMode === 'signup') {
      const checkRes = await fetch(`${SUPA_URL}/rest/v1/accounts?username=eq.${encodeURIComponent(u)}&select=username`, { headers: HEADERS });
      const existing = await checkRes.json();
      if(Array.isArray(existing) && existing.length > 0){
        toast('Username already exists. Please Sign In.');
        btn.disabled = false;
        btn.textContent = 'CREATE ACCOUNT →';
        return;
      }

      const newRecord = {
        username: u, password: p, xp: 0, streak: 1, total_seconds: 0, unlocked_level: 1, completed_lessons: [], lab_tasks_done: [], practice_dates: [new Date().toISOString().slice(0,10)]
      };

      const insertRes = await fetch(`${SUPA_URL}/rest/v1/accounts`, {
        method: 'POST',
        headers: HEADERS,
        body: JSON.stringify(newRecord)
      });

      if(!insertRes.ok){
        const err = await insertRes.text();
        throw new Error(err);
      }

      state = newRecord;
    } else {
      const fetchRes = await fetch(`${SUPA_URL}/rest/v1/accounts?username=eq.${encodeURIComponent(u)}&select=*`, { headers: HEADERS });
      const rows = await fetchRes.json();
      
      if(!Array.isArray(rows) || rows.length === 0){
        toast('Account not found. Choose Create Account first.');
        btn.disabled = false;
        btn.textContent = 'SIGN IN →';
        return;
      }

      if(rows[0].password !== p){
        toast('Incorrect passphrase.');
        btn.disabled = false;
        btn.textContent = 'SIGN IN →';
        return;
      }

      state = { ...DEFAULT_STATE, ...rows[0] };
    }

    localStorage.setItem('qalam_user_cache', JSON.stringify(state));
    enterApp();
    soundClick();
    toast(`Connected as ${state.username}!`);
  } catch (err) {
    alert(`Supabase Connection Error:\n${err.message}`);
  } finally {
    btn.disabled = false;
    btn.textContent = authMode === 'login' ? 'SIGN IN →' : 'CREATE ACCOUNT →';
  }
}

