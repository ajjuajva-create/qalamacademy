function evaluateWriting() {
  const text = document.getElementById('labText').value.trim();
  if(!text){ soundWrong(); toast('Write or paste draft text first.'); return; }
  const words = text.split(/\s+/).filter(Boolean);
  const sentences = text.split(/[.!?]+/).filter(x => x.trim()).length || 1;
  const avg = words.length / sentences;
  const filler = (text.match(/\b(very|really|basically|in order to|due to the fact that|in my opinion|I think)\b/gi)||[]).length;
  const clarity = Math.max(50, Math.min(98, 90 - filler*6));
  const concision = Math.max(45, Math.min(98, 88 - (avg > 26 ? 12 : 0)));
  const vocab = Math.max(50, Math.min(96, 80 + (words.length > 50 ? 8 : 0)));
  const style = Math.round((clarity + concision + vocab) / 3);

  document.getElementById('scoreGrid').innerHTML = `
    <div class="score-box"><strong>${clarity}</strong><span>CLARITY</span></div>
    <div class="score-box"><strong>${concision}</strong><span>CONCISION</span></div>
    <div class="score-box"><strong>${vocab}</strong><span>VOCAB</span></div>
    <div class="score-box"><strong>${style}</strong><span>STYLE</span></div>
  `;

  document.getElementById('feedbackPoints').innerHTML = `
    <div>✦ Sentence length averages ${Math.round(avg)} words per sentence. Ideal is around 15–20 words.</div>
    <div>✦ Detected ${filler} filler words. Removing them makes your writing punchier.</div>
  `;
  document.getElementById('labResults').classList.remove('hidden');
  soundCorrect();
}

function clearLab() {
  document.getElementById('labText').value = '';
  document.getElementById('labResults').classList.add('hidden');
  soundClick();
}

function renderProgress() {
  document.getElementById('repXP').textContent = state.xp || 0;
  document.getElementById('repSessions').textContent = (state.completed_lessons || []).length;
  document.getElementById('repTasks').textContent = (state.lab_tasks_done || []).length;
  document.getElementById('repStreak').textContent = state.streak || 1;

  const now = new Date(), days = [];
  for(let i=6; i>=0; i--){
    const d = new Date(now);
    d.setDate(d.getDate() - i);
    days.push(d);
  }
  const dates = new Set(state.practice_dates || []);
  document.getElementById('daysGrid').innerHTML = days.map((d, i) => {
    const key = d.toISOString().slice(0,10);
    return `<div class="day ${dates.has(key)?'done':''} ${i===6?'today':''}"><span>${d.toLocaleDateString(undefined,{weekday:'short'})}</span><i></i></div>`;
  }).join('');

  document.getElementById('userAccountDetails').textContent = 
    `Connected Account: ${state.username} | Cloud XP: ${state.xp} | Level: ${state.unlocked_level}`;
}

// LESSON ENGINE
function startLessonById(id) {
  const l = LESSONS.find(x => x.id === id);
  if(!l) return;
  currentLesson = l; stepIndex = 0; correctCount = 0; selected = null; answered = false; elapsed = 0;
  
  document.body.classList.add('in-lesson');
  document.getElementById('appScreen').classList.add('hidden');
  document.getElementById('lessonScreen').classList.remove('hidden');

  clearInterval(timer);
  timer = setInterval(() => {
    elapsed++;
    const m = String(Math.floor(elapsed/60)).padStart(2,'0');
    const s = String(elapsed%60).padStart(2,'0');
    document.getElementById('lessonTimer').textContent = `${m}:${s}`;
  }, 1000);

  soundClick();
  renderStep();
}

function renderStep() {
  answered = false; selected = null;
  const l = currentLesson, q = l.steps[stepIndex];
  document.getElementById('lessonTitle').textContent = l.title;
  document.getElementById('lessonBar').style.width = `${(stepIndex/l.steps.length)*100}%`;
  document.getElementById('teachBox').innerHTML = `
    <div class="eyebrow">Writing Rule</div>
    <p style="font-size:15px;margin-top:6px;line-height:1.6">${l.teach}</p>
    <div class="weak-ex"><strong>Instead of:</strong> ${l.examples[0]}</div>
    <div class="strong-ex"><strong>Try this:</strong> ${l.examples[1]}</div>
  `;
  document.getElementById('questionTitle').textContent = q.title;
  document.getElementById('questionHint').textContent = q.hint || '';
  
  const area = document.getElementById('questionArea');
  if(q.type === 'mcq'){
    area.innerHTML = q.options.map((opt, i) => `
      <button class="option" onclick="selectOpt(${i})">${opt}</button>
    `).join('');
  } else {
    area.innerHTML = `
      <div class="field"><textarea id="lessonInput" placeholder="Type your answer here..." style="min-height:130px"></textarea></div>
      <div class="muted" style="font-size:13px"><strong>Example answer:</strong> ${q.example}</div>
    `;
    document.getElementById('lessonInput').addEventListener('input', () => {
      document.getElementById('lessonAction').disabled = document.getElementById('lessonInput').value.trim().split(/\s+/).filter(Boolean).length < 2;
    });
  }

  document.getElementById('lessonFeedback').textContent = "Select an answer or type your response to proceed.";
  const btn = document.getElementById('lessonAction');
  btn.textContent = "CHECK";
  btn.disabled = q.type === 'mcq';
}

function selectOpt(i) {
  if(answered) return;
  selected = i;
  soundClick();
  document.querySelectorAll('.option').forEach((b, idx) => b.classList.toggle('selected', idx === i));
  document.getElementById('lessonAction').disabled = false;
}

function evaluateStep() {
  if(answered) {
    stepIndex++;
    if(stepIndex >= currentLesson.steps.length) finishLesson();
    else renderStep();
    return;
  }
  const q = currentLesson.steps[stepIndex];
  let pass = false;
  if(q.type === 'mcq'){
    pass = selected === q.correct;
    document.querySelectorAll('.option').forEach((el, i) => {
      if(i === q.correct) el.classList.add('correct');
      if(i === selected && !pass) el.classList.add('wrong');
    });
  } else {
    pass = q.validate(document.getElementById('lessonInput').value);
  }

  if(pass) {
    correctCount++;
    soundCorrect();
  } else {
    soundWrong();
  }
  answered = true;

  const btn = document.getElementById('lessonAction');
  btn.textContent = stepIndex === currentLesson.steps.length-1 ? "FINISH LESSON →" : "CONTINUE →";
  document.getElementById('lessonFeedback').innerHTML = pass ? 
    `<span style="color:var(--green)">✓ Correct:</span> ${q.explain}` : 
    `<span style="color:var(--red)">Tip:</span> ${q.explain}`;
}

async function finishLesson() {
  clearInterval(timer);
  document.body.classList.remove('in-lesson');
  
  state.xp = (state.xp || 0) + 20;
  state.total_seconds = (state.total_seconds || 0) + elapsed;
  if(!state.completed_lessons) state.completed_lessons = [];
  if(!state.completed_lessons.includes(currentLesson.id)){
    state.completed_lessons.push(currentLesson.id);
  }
  if(state.unlocked_level <= currentLesson.level && currentLesson.level < LESSONS.length){
    state.unlocked_level = currentLesson.level + 1;
  }

  const today = new Date().toISOString().slice(0,10);
  if(!state.practice_dates) state.practice_dates = [];
  if(!state.practice_dates.includes(today)){
    state.practice_dates.push(today);
  }

  localStorage.setItem('qalam_user_cache', JSON.stringify(state));
  await syncProgressToCloud();

  soundComplete();
  document.getElementById('resultXP').textContent = "+20 XP";
  document.getElementById('lessonScreen').classList.add('hidden');
  document.getElementById('resultScreen').classList.remove('hidden');
}

function leaveLesson() {
  clearInterval(timer);
  document.body.classList.remove('in-lesson');
  document.getElementById('lessonScreen').classList.add('hidden');
  document.getElementById('appScreen').classList.remove('hidden');
  navigate('home');
  soundClick();
}

function backFromResult() {
  document.getElementById('resultScreen').classList.add('hidden');
  document.getElementById('appScreen').classList.remove('hidden');
  navigate('home');
  soundClick();
}

function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.remove('hidden');
  setTimeout(() => t.classList.add('hidden'), 2800);
}

window.addEventListener('DOMContentLoaded', () => {
  const cached = localStorage.getItem('qalam_user_cache');
  if(cached){
    try {
      state = JSON.parse(cached);
      enterApp();
    } catch(e) {
      document.getElementById('authScreen').classList.remove('hidden');
    }
  } else {
    document.getElementById('authScreen').classList.remove('hidden');
  }
});
</script>
